# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Local secrets — never commit
.env

# Local database
*.db
*.db-journal
*.db-wal
*.db-shm

# Model cache (fastembed downloads bge-small/jina here on first use — never commit weights)
.fastembed_cache/
